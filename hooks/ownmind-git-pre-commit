#!/bin/sh
# OwnMind Git Pre-Commit Hook — Shell Wrapper
# Runs the Node.js pre-commit verification, then chains existing hooks if present.

node "$HOME/.ownmind/hooks/ownmind-git-pre-commit.js"
RESULT=$?
if [ $RESULT -ne 0 ]; then
  exit 1
fi

# 0. The global hooks path that was set before OwnMind took it over (the installer records
#    it in .previous-hooks-path next to this file); it used to be overwritten and forgotten.
PREV_FILE="$(dirname "$0")/.previous-hooks-path"
if [ -f "$PREV_FILE" ]; then
  PREV_DIR="$(cat "$PREV_FILE")"
  if [ -n "$PREV_DIR" ] && [ -x "$PREV_DIR/pre-commit" ] && [ "$(CDPATH= cd "$PREV_DIR" && pwd)" != "$(CDPATH= cd "$(dirname "$0")" && pwd)" ]; then
    "$PREV_DIR/pre-commit" || exit $?
  fi
fi

# Chain existing hooks (core.hooksPath 設定後 git 忽略 .git/hooks/，需要手動 chain)
# 1. 先檢查 repo 自己的 .git/hooks/pre-commit（被 core.hooksPath 覆蓋的原有 hook）
if [ -x "$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-commit" ]; then
  "$(git rev-parse --git-common-dir)/hooks/pre-commit"
  exit $?
fi
# 2. 再檢查 .local 慣例（husky 等工具遷移後的 hook）
if [ -x .git/hooks/pre-commit.local ]; then
  .git/hooks/pre-commit.local
  exit $?
fi

exit 0
