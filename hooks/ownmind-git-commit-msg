#!/usr/bin/env bash
# OwnMind commit-trailer guard: reject commits adding Co-Authored-By trailer.
# Bypass (not recommended): git commit --no-verify
set -e

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

if grep -qiE '^[[:space:]]*Co-Authored-By:' "$MSG_FILE"; then
  echo "❌ Commit-trailer violation: commit message contains 'Co-Authored-By' trailer." >&2
  echo "   你的鐵律：git commit 不加 Co-Authored-By。" >&2
  echo "   如需強制覆蓋（不建議），用 git commit --no-verify。" >&2
  exit 1
fi

exit 0
