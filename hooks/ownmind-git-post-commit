#!/bin/sh
# OwnMind Git Post-Commit Hook — Shell Wrapper
# Runs the Node.js post-commit verification, then chains existing hooks if present.

# A machine with no Node of its own runs the private one in ~/.ownmind/runtime/current; no other
# PATH has it (node.exe sits at its top on Windows, where this hook runs under Git's own sh).
if [ -d "$HOME/.ownmind/runtime/current/bin" ]; then PATH="$HOME/.ownmind/runtime/current/bin:$PATH"; export PATH;
elif [ -f "$HOME/.ownmind/runtime/current/node.exe" ]; then PATH="$HOME/.ownmind/runtime/current:$PATH"; export PATH; fi
node "$HOME/.ownmind/hooks/ownmind-git-post-commit.js"

# Chain existing hooks
# The global hooks path from before OwnMind took it over, recorded by the installer.
PREV_FILE="$(dirname "$0")/.previous-hooks-path"
if [ -f "$PREV_FILE" ]; then
  PREV_DIR="$(cat "$PREV_FILE")"
  if [ -n "$PREV_DIR" ] && [ -x "$PREV_DIR/post-commit" ] && [ "$(CDPATH= cd "$PREV_DIR" && pwd)" != "$(CDPATH= cd "$(dirname "$0")" && pwd)" ]; then
    "$PREV_DIR/post-commit"
  fi
fi

if [ -x "$(git rev-parse --git-common-dir 2>/dev/null)/hooks/post-commit" ]; then
  "$(git rev-parse --git-common-dir)/hooks/post-commit"
  exit $?
fi
if [ -x .git/hooks/post-commit.local ]; then
  .git/hooks/post-commit.local
  exit $?
fi

exit 0
