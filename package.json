{
  "name": "ownmind",
  "version": "1.26.150",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/ensure-console-build.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npm run lint:zh-only && node --test --test-timeout=300000",
    "test:watch": "node --test --test-timeout=300000 --watch",
    "lint:zh-only": "node scripts/lint-zh-only.js client/src",
    "build:client": "cd client && npm install && npm run build",
    "dev:client": "cd client && npm run dev",
    "translate:client": "cd client && npm run translate",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miou1107/ownmind.git"
  },
