  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/miou1107/ownmind/issues"
  },
  "homepage": "https://github.com/miou1107/ownmind#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.3.1",
    "node-cron": "^4.2.1",
    "node-machine-id": "^1.1.12",
    "pg": "^8.20.0",
    "pgvector": "^0.2.1",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
