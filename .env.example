# Server
PORT=3000

# Database (use 'db' for Docker, 'localhost' for local dev)
DB_HOST=db
DB_PORT=5432
DB_NAME=ownmind
DB_USER=ownmind
DB_PASSWORD=your_secure_password_here

# Encryption (for secrets management, at least 32 chars; 未設定或使用預設值則拒絕啟動)
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Setup token (首次設定 super_admin 密碼時必須帶此 token；未設定則 /setup 端點停用)
SETUP_TOKEN=

# CORS：允許跨域的 origin（留空則禁止所有跨域請求，建議不設定）
CORS_ORIGIN=

# Logging
LOG_LEVEL=info

# LLM Switch — 用於 /me 敘事報告 LLM 洞察（v1.17.47+）
# 沒設則 /api/me/narrative/insights 回 503，機械版報告仍可用
# OWNMIND_LLM_API_BASE：OpenAI 相容 API 的 base URL（例如 https://your-host/llm-switch/v1）
# LLM_SWITCH_API_KEY：對應的 API key
OWNMIND_LLM_API_BASE=
LLM_SWITCH_API_KEY=

# Production SSH host（scripts/health-report-daily.sh 用，例如 root@your-host）
OWNMIND_PROD_HOST=
